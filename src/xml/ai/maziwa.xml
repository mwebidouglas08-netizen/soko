<xml xmlns="https://developers.google.com/blockly/xml" collection="false" is_dbot="true">
  <variables>
    <variable id="mz_stake">Stake</variable>
    <variable id="mz_base_stake">Base Stake</variable>
    <variable id="mz_martingale">Martingale</variable>
    <variable id="mz_take_profit">Take Profit</variable>
    <variable id="mz_stop_loss">Stop Loss</variable>
    <variable id="mz_max_trades">Max Trades</variable>
    <variable id="mz_trades">Trades</variable>
    <variable id="mz_signal">Entry Signal</variable>
    <variable id="mz_direction">Trade Direction</variable>
    <variable id="mz_prediction">Prediction</variable>
    <variable id="mz_recovery_mode">Recovery Mode</variable>
    <variable id="mz_loss_streak">Loss Streak</variable>
    <variable id="mz_max_loss_streak">Max Loss Streak</variable>
    <variable id="mz_duration">Duration</variable>
  </variables>
  <block type="trade_definition" id="mz_trade_definition" deletable="false" x="0" y="60">
    <comment pinned="false" h="190" w="460">Maziwa AI — premium high-frequency multi-market scanner for Over/Under digits. Rotates across synthetic markets every contract, scans continuously (0.5s) for immediate opportunities and prioritizes Over 2 and Under 8 entries with 1-tick duration. Includes martingale recovery with capped streak, take profit, stop loss, and max trades. Test on demo first; trading carries risk and no outcome is guaranteed.</comment>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="mz_market" deletable="false" movable="false">
        <mutation xmlns="http://www.w3.org/1999/xhtml" vh_enabled="false" vh_max_steps="1" vh_min_trades="1" vh_stake="0.35"></mutation>
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <field name="ALTERNATE_MARKETS">TRUE</field>
        <field name="ALTERNATE_EVERY">1</field>
        <field name="MULTI_MARKET">TRUE</field>
        <field name="VH_ENABLED">FALSE</field>
        <field name="VH_SETTINGS_BTN">VH Settings</field>
        <next>
          <block type="trade_definition_tradetype" id="mz_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="mz_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="mz_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="mz_restart_buy_sell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="mz_restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="mz_set_stake">
        <field name="VAR" id="mz_stake">Stake</field>
        <value name="VALUE"><block type="math_number" id="mz_stake_value"><field name="NUM">0.35</field></block></value>
        <next><block type="variables_set" id="mz_set_base_stake">
          <field name="VAR" id="mz_base_stake">Base Stake</field>
          <value name="VALUE"><block type="math_number" id="mz_base_stake_value"><field name="NUM">0.35</field></block></value>
          <next><block type="variables_set" id="mz_set_martingale">
            <field name="VAR" id="mz_martingale">Martingale</field>
            <value name="VALUE"><block type="math_number" id="mz_martingale_value"><field name="NUM">2.1</field></block></value>
            <next><block type="variables_set" id="mz_set_tp">
              <field name="VAR" id="mz_take_profit">Take Profit</field>
              <value name="VALUE"><block type="math_number" id="mz_tp_value"><field name="NUM">12</field></block></value>
              <next><block type="variables_set" id="mz_set_sl">
                <field name="VAR" id="mz_stop_loss">Stop Loss</field>
                <value name="VALUE"><block type="math_number" id="mz_sl_value"><field name="NUM">35</field></block></value>
                <next><block type="variables_set" id="mz_set_max_trades">
                  <field name="VAR" id="mz_max_trades">Max Trades</field>
                  <value name="VALUE"><block type="math_number" id="mz_max_trades_value"><field name="NUM">120</field></block></value>
                  <next><block type="variables_set" id="mz_set_trades">
                    <field name="VAR" id="mz_trades">Trades</field>
                    <value name="VALUE"><block type="math_number" id="mz_trades_value"><field name="NUM">0</field></block></value>
                    <next><block type="variables_set" id="mz_set_signal">
                      <field name="VAR" id="mz_signal">Entry Signal</field>
                      <value name="VALUE"><block type="logic_boolean" id="mz_signal_value"><field name="BOOL">FALSE</field></block></value>
                      <next><block type="variables_set" id="mz_set_direction">
                        <field name="VAR" id="mz_direction">Trade Direction</field>
                        <value name="VALUE"><block type="math_number" id="mz_direction_value"><field name="NUM">4</field></block></value>
                        <next><block type="variables_set" id="mz_set_prediction">
                          <field name="VAR" id="mz_prediction">Prediction</field>
                          <value name="VALUE"><block type="math_number" id="mz_prediction_value"><field name="NUM">2</field></block></value>
                          <next><block type="variables_set" id="mz_set_recovery">
                            <field name="VAR" id="mz_recovery_mode">Recovery Mode</field>
                            <value name="VALUE"><block type="logic_boolean" id="mz_recovery_value"><field name="BOOL">FALSE</field></block></value>
                            <next><block type="variables_set" id="mz_set_loss_streak">
                              <field name="VAR" id="mz_loss_streak">Loss Streak</field>
                              <value name="VALUE"><block type="math_number" id="mz_loss_streak_value"><field name="NUM">0</field></block></value>
                              <next><block type="variables_set" id="mz_set_max_loss_streak">
                                <field name="VAR" id="mz_max_loss_streak">Max Loss Streak</field>
                                <value name="VALUE"><block type="math_number" id="mz_max_loss_streak_value"><field name="NUM">5</field></block></value>
                                <next><block type="variables_set" id="mz_set_duration">
                                  <field name="VAR" id="mz_duration">Duration</field>
                                  <value name="VALUE"><block type="math_number" id="mz_duration_value"><field name="NUM">1</field></block></value>
                                </block></next>
                              </block></next>
                            </block></next>
                          </block></next>
                        </block></next>
                      </block></next>
                    </block></next>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="variables_set" id="mz_reset_signal_each_cycle">
        <field name="VAR" id="mz_signal">Entry Signal</field>
        <value name="VALUE"><block type="logic_boolean" id="mz_reset_signal_false"><field name="BOOL">FALSE</field></block></value>
        <next>
          <block type="controls_whileUntil" id="mz_scan_loop" collapsed="true">
            <field name="MODE">UNTIL</field>
            <value name="BOOL"><block type="variables_get" id="mz_signal_read_loop"><field name="VAR" id="mz_signal">Entry Signal</field></block></value>
            <statement name="DO">
              <block type="timeout" id="mz_scan_delay">
                <statement name="TIMEOUTSTACK">
                  <block type="controls_if" id="mz_scan_logic">
                    <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="3"></mutation>
                    <value name="IF0">
                      <block type="last_digits_condition" id="mz_ultra_low">
                        <field name="CONDITION">LESS_OR_EQUAL</field>
                        <value name="N"><block type="math_number" id="mz_ultra_low_n"><field name="NUM">3</field></block></value>
                        <value name="COMPARE_VALUE"><block type="math_number" id="mz_ultra_low_cmp"><field name="NUM">1</field></block></value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="mz_set_over_ultra_dir"><field name="VAR" id="mz_direction">Trade Direction</field><value name="VALUE"><block type="math_number" id="mz_dir_over_ultra"><field name="NUM">4</field></block></value>
                        <next><block type="variables_set" id="mz_set_over_ultra_pred"><field name="VAR" id="mz_prediction">Prediction</field><value name="VALUE"><block type="math_number" id="mz_pred_over_ultra"><field name="NUM">2</field></block></value>
                          <next><block type="variables_set" id="mz_signal_over_ultra"><field name="VAR" id="mz_signal">Entry Signal</field><value name="VALUE"><block type="logic_boolean" id="mz_signal_true_over_ultra"><field name="BOOL">TRUE</field></block></value></block></next>
                        </block></next>
                      </block>
                    </statement>
                    <value name="IF1">
                      <block type="last_digits_condition" id="mz_ultra_high">
                        <field name="CONDITION">GREATER_OR_EQUAL</field>
                        <value name="N"><block type="math_number" id="mz_ultra_high_n"><field name="NUM">3</field></block></value>
                        <value name="COMPARE_VALUE"><block type="math_number" id="mz_ultra_high_cmp"><field name="NUM">8</field></block></value>
                      </block>
                    </value>
                    <statement name="DO1">
                      <block type="variables_set" id="mz_set_under_ultra_dir"><field name="VAR" id="mz_direction">Trade Direction</field><value name="VALUE"><block type="math_number" id="mz_dir_under_ultra"><field name="NUM">5</field></block></value>
                        <next><block type="variables_set" id="mz_set_under_ultra_pred"><field name="VAR" id="mz_prediction">Prediction</field><value name="VALUE"><block type="math_number" id="mz_pred_under_ultra"><field name="NUM">8</field></block></value>
                          <next><block type="variables_set" id="mz_signal_under_ultra"><field name="VAR" id="mz_signal">Entry Signal</field><value name="VALUE"><block type="logic_boolean" id="mz_signal_true_under_ultra"><field name="BOOL">TRUE</field></block></value></block></next>
                        </block></next>
                      </block>
                    </statement>
                    <value name="IF2">
                      <block type="last_digits_condition" id="mz_low_cluster">
                        <field name="CONDITION">LESS_OR_EQUAL</field>
                        <value name="N"><block type="math_number" id="mz_low_n"><field name="NUM">4</field></block></value>
                        <value name="COMPARE_VALUE"><block type="math_number" id="mz_low_cmp"><field name="NUM">2</field></block></value>
                      </block>
                    </value>
                    <statement name="DO2">
                      <block type="variables_set" id="mz_set_over_dir"><field name="VAR" id="mz_direction">Trade Direction</field><value name="VALUE"><block type="math_number" id="mz_dir_over"><field name="NUM">4</field></block></value>
                        <next><block type="variables_set" id="mz_set_over_pred"><field name="VAR" id="mz_prediction">Prediction</field><value name="VALUE"><block type="math_number" id="mz_pred_over"><field name="NUM">2</field></block></value>
                          <next><block type="variables_set" id="mz_signal_over"><field name="VAR" id="mz_signal">Entry Signal</field><value name="VALUE"><block type="logic_boolean" id="mz_signal_true_over"><field name="BOOL">TRUE</field></block></value></block></next>
                        </block></next>
                      </block>
                    </statement>
                    <value name="IF3">
                      <block type="last_digits_condition" id="mz_high_cluster">
                        <field name="CONDITION">GREATER_OR_EQUAL</field>
                        <value name="N"><block type="math_number" id="mz_high_n"><field name="NUM">4</field></block></value>
                        <value name="COMPARE_VALUE"><block type="math_number" id="mz_high_cmp"><field name="NUM">7</field></block></value>
                      </block>
                    </value>
                    <statement name="DO3">
                      <block type="variables_set" id="mz_set_under_dir"><field name="VAR" id="mz_direction">Trade Direction</field><value name="VALUE"><block type="math_number" id="mz_dir_under"><field name="NUM">5</field></block></value>
                        <next><block type="variables_set" id="mz_set_under_pred"><field name="VAR" id="mz_prediction">Prediction</field><value name="VALUE"><block type="math_number" id="mz_pred_under"><field name="NUM">8</field></block></value>
                          <next><block type="variables_set" id="mz_signal_under"><field name="VAR" id="mz_signal">Entry Signal</field><value name="VALUE"><block type="logic_boolean" id="mz_signal_true_under"><field name="BOOL">TRUE</field></block></value></block></next>
                        </block></next>
                      </block>
                    </statement>
                  </block>
                </statement>
                <value name="SECONDS"><block type="math_number" id="mz_delay_value"><field name="NUM">0.5</field></block></value>
              </block>
            </statement>
            <next>
              <block type="trade_definition_tradeoptions" id="mz_trade_options">
                <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
                <field name="DURATIONTYPE_LIST">t</field>
                <value name="DURATION"><block type="variables_get" id="mz_duration_value_ref"><field name="VAR" id="mz_duration">Duration</field></block></value>
                <value name="AMOUNT"><shadow type="math_number_positive" id="mz_amount_shadow"><field name="NUM">0.35</field></shadow><block type="variables_get" id="mz_get_stake_amt"><field name="VAR" id="mz_stake">Stake</field></block></value>
                <value name="PREDICTION"><shadow type="math_number_positive" id="mz_prediction_shadow"><field name="NUM">2</field></shadow><block type="variables_get" id="mz_get_prediction_amt"><field name="VAR" id="mz_prediction">Prediction</field></block></value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="mz_after_purchase" x="760" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="math_change" id="mz_inc_trades"><field name="VAR" id="mz_trades">Trades</field><value name="DELTA"><shadow type="math_number" id="mz_inc_trades_one"><field name="NUM">1</field></shadow></value>
        <next>
          <block type="controls_if" id="mz_result_check">
            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0"><block type="contract_check_result" id="mz_is_win"><field name="CHECK_RESULT">win</field></block></value>
            <statement name="DO0">
              <block type="variables_set" id="mz_reset_stake_win"><field name="VAR" id="mz_stake">Stake</field><value name="VALUE"><block type="variables_get" id="mz_base_on_win"><field name="VAR" id="mz_base_stake">Base Stake</field></block></value>
                <next><block type="variables_set" id="mz_reset_loss_streak_win"><field name="VAR" id="mz_loss_streak">Loss Streak</field><value name="VALUE"><block type="math_number" id="mz_loss_streak_zero"><field name="NUM">0</field></block></value>
                  <next><block type="variables_set" id="mz_recovery_off_win"><field name="VAR" id="mz_recovery_mode">Recovery Mode</field><value name="VALUE"><block type="logic_boolean" id="mz_recovery_false_win"><field name="BOOL">FALSE</field></block></value></block></next>
                </block></next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="math_change" id="mz_inc_loss_streak"><field name="VAR" id="mz_loss_streak">Loss Streak</field><value name="DELTA"><shadow type="math_number" id="mz_loss_streak_one"><field name="NUM">1</field></shadow></value>
                <next><block type="variables_set" id="mz_recovery_on_loss"><field name="VAR" id="mz_recovery_mode">Recovery Mode</field><value name="VALUE"><block type="logic_boolean" id="mz_recovery_true_loss"><field name="BOOL">TRUE</field></block></value>
                  <next><block type="controls_if" id="mz_cap_loss_streak"><mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
                    <value name="IF0"><block type="logic_compare" id="mz_loss_streak_check"><field name="OP">LT</field><value name="A"><block type="variables_get" id="mz_loss_streak_read"><field name="VAR" id="mz_loss_streak">Loss Streak</field></block></value><value name="B"><block type="variables_get" id="mz_max_loss_streak_read"><field name="VAR" id="mz_max_loss_streak">Max Loss Streak</field></block></value></block></value>
                    <statement name="DO0"><block type="variables_set" id="mz_martingale_stake"><field name="VAR" id="mz_stake">Stake</field><value name="VALUE"><block type="math_arithmetic" id="mz_multiply_stake"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get" id="mz_stake_read_loss"><field name="VAR" id="mz_stake">Stake</field></block></value><value name="B"><block type="variables_get" id="mz_martingale_read"><field name="VAR" id="mz_martingale">Martingale</field></block></value></block></value></block></statement>
                    <statement name="ELSE"><block type="variables_set" id="mz_reset_stake_cap"><field name="VAR" id="mz_stake">Stake</field><value name="VALUE"><block type="variables_get" id="mz_base_on_cap"><field name="VAR" id="mz_base_stake">Base Stake</field></block></value>
                      <next><block type="variables_set" id="mz_reset_loss_streak_cap"><field name="VAR" id="mz_loss_streak">Loss Streak</field><value name="VALUE"><block type="math_number" id="mz_loss_streak_cap_zero"><field name="NUM">0</field></block></value></block></next>
                    </block></statement>
                  </block></next>
                </block></next>
              </block>
            </statement>
            <next>
              <block type="controls_if" id="mz_session_gate">
                <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="2" else="1"></mutation>
                <value name="IF0"><block type="logic_compare" id="mz_tp_check"><field name="OP">GTE</field><value name="A"><block type="total_profit" id="mz_total_profit_tp"></block></value><value name="B"><block type="variables_get" id="mz_tp_read"><field name="VAR" id="mz_take_profit">Take Profit</field></block></value></block></value>
                <statement name="DO0"><block type="text_print" id="mz_tp_print"><value name="TEXT"><shadow type="text" id="mz_tp_text"><field name="TEXT">Maziwa AI: Take Profit reached. Session stopped.</field></shadow></value></block></statement>
                <value name="IF1"><block type="logic_compare" id="mz_sl_check"><field name="OP">LTE</field><value name="A"><block type="total_profit" id="mz_total_profit_sl"></block></value><value name="B"><block type="math_single" id="mz_neg_sl"><field name="OP">NEG</field><value name="NUM"><block type="variables_get" id="mz_sl_read"><field name="VAR" id="mz_stop_loss">Stop Loss</field></block></value></block></value></block></value>
                <statement name="DO1"><block type="text_print" id="mz_sl_print"><value name="TEXT"><shadow type="text" id="mz_sl_text"><field name="TEXT">Maziwa AI: Stop Loss reached. Session stopped.</field></shadow></value></block></statement>
                <value name="IF2"><block type="logic_compare" id="mz_max_trades_check"><field name="OP">GTE</field><value name="A"><block type="variables_get" id="mz_trades_read"><field name="VAR" id="mz_trades">Trades</field></block></value><value name="B"><block type="variables_get" id="mz_max_trades_read_gate"><field name="VAR" id="mz_max_trades">Max Trades</field></block></value></block></value>
                <statement name="DO2"><block type="text_print" id="mz_max_trades_print"><value name="TEXT"><shadow type="text" id="mz_max_trades_text"><field name="TEXT">Maziwa AI: Max trades reached. Session stopped.</field></shadow></value></block></statement>
                <statement name="ELSE"><block type="trade_again" id="mz_trade_again"></block></statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="mz_before_purchase" collapsed="true" deletable="false" x="0" y="1200">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="mz_purchase_choice">
        <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1"></mutation>
        <value name="IF0"><block type="logic_compare" id="mz_is_over"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="mz_dir_read_over"><field name="VAR" id="mz_direction">Trade Direction</field></block></value><value name="B"><block type="math_number" id="mz_over_code"><field name="NUM">4</field></block></value></block></value>
        <statement name="DO0"><block type="apollo_purchase2" id="mz_buy_over"><field name="PURCHASE_LIST">DIGITOVER</field><value name="PREDICTION"><shadow type="math_number_positive" id="mz_buy_over_pred_shadow"><field name="NUM">2</field></shadow><block type="variables_get" id="mz_buy_over_pred"><field name="VAR" id="mz_prediction">Prediction</field></block></value></block></statement>
        <value name="IF1"><block type="logic_compare" id="mz_is_under"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="mz_dir_read_under"><field name="VAR" id="mz_direction">Trade Direction</field></block></value><value name="B"><block type="math_number" id="mz_under_code"><field name="NUM">5</field></block></value></block></value>
        <statement name="DO1"><block type="apollo_purchase2" id="mz_buy_under"><field name="PURCHASE_LIST">DIGITUNDER</field><value name="PREDICTION"><shadow type="math_number_positive" id="mz_buy_under_pred_shadow"><field name="NUM">8</field></shadow><block type="variables_get" id="mz_buy_under_pred"><field name="VAR" id="mz_prediction">Prediction</field></block></value></block></statement>
      </block>
    </statement>
  </block>
</xml>
