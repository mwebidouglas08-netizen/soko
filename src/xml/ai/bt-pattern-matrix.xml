<xml xmlns="https://developers.google.com/blockly/xml" collection="false" is_dbot="true">
  <variables>
    <variable id="btpm_stake">Stake</variable>
    <variable id="btpm_martingale">Martingale</variable>
    <variable id="btpm_signal">Entry Signal</variable>
    <variable id="btpm_take_profit">Take Profit</variable>
    <variable id="btpm_base_stake">Stake []</variable>
    <variable id="btpm_runs">Runs</variable>
    <variable id="btpm_direction">Trade Direction</variable>
    <variable id="btpm_stop_loss">Stop Loss</variable>
  </variables>
  <block type="trade_definition" id="btpm_trade_definition" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="btpm_market" deletable="false" movable="false">
        <mutation xmlns="http://www.w3.org/1999/xhtml" vh_enabled="false" vh_max_steps="1" vh_min_trades="1" vh_stake="0.35"></mutation>
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_75</field>
        <field name="ALTERNATE_MARKETS">FALSE</field>
        <field name="ALTERNATE_EVERY">1</field>
        <field name="MULTI_MARKET">FALSE</field>
        <field name="VH_ENABLED">FALSE</field>
        <field name="VH_SETTINGS_BTN">VH Settings</field>
        <next>
          <block type="trade_definition_tradetype" id="btpm_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="btpm_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="btpm_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="btpm_restart_buy_sell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="btpm_restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="btpm_set_stake">
        <field name="VAR" id="btpm_stake">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="btpm_stake_value">
            <field name="NUM">0.5</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="btpm_set_martingale">
            <field name="VAR" id="btpm_martingale">Martingale</field>
            <value name="VALUE">
              <block type="math_number" id="btpm_martingale_value">
                <field name="NUM">1.8</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="btpm_set_take_profit">
                <field name="VAR" id="btpm_take_profit">Take Profit</field>
                <value name="VALUE">
                  <block type="math_number" id="btpm_take_profit_value">
                    <field name="NUM">12</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="btpm_set_stop_loss">
                    <field name="VAR" id="btpm_stop_loss">Stop Loss</field>
                    <value name="VALUE">
                      <block type="math_number" id="btpm_stop_loss_value">
                        <field name="NUM">45</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="btpm_reset_runs_start" collapsed="true">
                        <field name="VAR" id="btpm_runs">Runs</field>
                        <value name="VALUE">
                          <block type="math_number" id="btpm_zero_start">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="btpm_reset_signal_start" collapsed="true">
                            <field name="VAR" id="btpm_signal">Entry Signal</field>
                            <value name="VALUE">
                              <block type="logic_boolean" id="btpm_false_start">
                                <field name="BOOL">FALSE</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="btpm_init_direction" collapsed="true">
                                <field name="VAR" id="btpm_direction">Trade Direction</field>
                                <value name="VALUE">
                                  <block type="math_number" id="btpm_direction_start">
                                    <field name="NUM">4</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="variables_set" id="btpm_set_base_stake" collapsed="true">
        <field name="VAR" id="btpm_base_stake">Stake []</field>
        <value name="VALUE">
          <block type="variables_get" id="btpm_base_stake_read">
            <field name="VAR" id="btpm_stake">Stake</field>
          </block>
        </value>
        <next>
          <block type="controls_whileUntil" id="btpm_scan_loop" collapsed="true">
            <field name="MODE">UNTIL</field>
            <value name="BOOL">
              <block type="variables_get" id="btpm_signal_read">
                <field name="VAR" id="btpm_signal">Entry Signal</field>
              </block>
            </value>
            <statement name="DO">
              <block type="timeout" id="btpm_scan_delay">
                <statement name="TIMEOUTSTACK">
                  <block type="controls_if" id="btpm_signal_choice">
                    <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="2"></mutation>
                    <value name="IF0">
                      <block type="last_digits_condition" id="btpm_run_even">
                        <field name="CONDITION">ALL_EVEN</field>
                        <value name="N">
                          <shadow type="math_number" id="btpm_run_even_n">
                            <field name="NUM">4</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="btpm_direction_even">
                        <field name="VAR" id="btpm_direction">Trade Direction</field>
                        <value name="VALUE">
                          <block type="math_number" id="btpm_even_direction_value">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="btpm_signal_even">
                            <field name="VAR" id="btpm_signal">Entry Signal</field>
                            <value name="VALUE">
                              <block type="logic_boolean" id="btpm_true_even">
                                <field name="BOOL">TRUE</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <value name="IF1">
                      <block type="last_digits_condition" id="btpm_run_odd">
                        <field name="CONDITION">ALL_ODD</field>
                        <value name="N">
                          <shadow type="math_number" id="btpm_run_odd_n">
                            <field name="NUM">4</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                    <statement name="DO1">
                      <block type="variables_set" id="btpm_direction_odd">
                        <field name="VAR" id="btpm_direction">Trade Direction</field>
                        <value name="VALUE">
                          <block type="math_number" id="btpm_odd_direction_value">
                            <field name="NUM">1</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="btpm_signal_odd">
                            <field name="VAR" id="btpm_signal">Entry Signal</field>
                            <value name="VALUE">
                              <block type="logic_boolean" id="btpm_true_odd">
                                <field name="BOOL">TRUE</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <value name="IF2">
                      <block type="last_digits_condition" id="btpm_repeat">
                        <field name="CONDITION">REPEAT</field>
                        <value name="N">
                          <shadow type="math_number" id="btpm_repeat_n">
                            <field name="NUM">3</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                    <statement name="DO2">
                      <block type="variables_set" id="btpm_direction_repeat">
                        <field name="VAR" id="btpm_direction">Trade Direction</field>
                        <value name="VALUE">
                          <block type="math_number" id="btpm_repeat_direction_value">
                            <field name="NUM">4</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="btpm_signal_repeat">
                            <field name="VAR" id="btpm_signal">Entry Signal</field>
                            <value name="VALUE">
                              <block type="logic_boolean" id="btpm_true_repeat">
                                <field name="BOOL">TRUE</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </statement>
                <value name="SECONDS">
                  <block type="math_number" id="btpm_delay_value">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="trade_definition_tradeoptions" id="btpm_trade_options">
                <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
                <field name="DURATIONTYPE_LIST">t</field>
                <value name="DURATION">
                  <shadow type="math_number_positive" id="btpm_duration">
                    <field name="NUM">1</field>
                  </shadow>
                </value>
                <value name="AMOUNT">
                  <shadow type="math_number_positive" id="btpm_amount_shadow">
                    <field name="NUM">1</field>
                  </shadow>
                  <block type="variables_get" id="btpm_get_stake">
                    <field name="VAR" id="btpm_stake">Stake</field>
                  </block>
                </value>
                <value name="PREDICTION">
                  <shadow type="math_number_positive" id="btpm_prediction_default">
                    <field name="NUM">2</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="btpm_after_purchase" x="714" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="btpm_result_check" collapsed="true">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="btpm_is_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="btpm_reset_stake_on_win">
            <field name="VAR" id="btpm_stake">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="btpm_base_stake_on_win">
                <field name="VAR" id="btpm_base_stake">Stake []</field>
              </block>
            </value>
            <next>
              <block type="math_change" id="btpm_increment_runs">
                <field name="VAR" id="btpm_runs">Runs</field>
                <value name="DELTA">
                  <shadow type="math_number" id="btpm_one_win">
                    <field name="NUM">1</field>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set" id="btpm_rearm_signal_on_win">
                    <field name="VAR" id="btpm_signal">Entry Signal</field>
                    <value name="VALUE">
                      <block type="logic_boolean" id="btpm_false_on_win">
                        <field name="BOOL">FALSE</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="btpm_martingale_on_loss">
            <field name="VAR" id="btpm_stake">Stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="btpm_martingale_multiply">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <shadow type="math_number" id="btpm_stake_shadow_loss">
                    <field name="NUM">1</field>
                  </shadow>
                  <block type="variables_get" id="btpm_current_stake_loss">
                    <field name="VAR" id="btpm_stake">Stake</field>
                  </block>
                </value>
                <value name="B">
                  <shadow type="math_number" id="btpm_multiplier_shadow">
                    <field name="NUM">1</field>
                  </shadow>
                  <block type="variables_get" id="btpm_multiplier_read">
                    <field name="VAR" id="btpm_martingale">Martingale</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="btpm_tp_sl_gate" collapsed="true">
            <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1" else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="btpm_take_profit_check">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="total_profit" id="btpm_total_profit_tp"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="btpm_read_take_profit">
                    <field name="VAR" id="btpm_take_profit">Take Profit</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="text_print" id="btpm_take_profit_message">
                <value name="TEXT">
                  <shadow type="text" id="btpm_take_profit_text">
                    <field name="TEXT">Take Profit reached</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <value name="IF1">
              <block type="logic_compare" id="btpm_stop_loss_check">
                <field name="OP">LTE</field>
                <value name="A">
                  <block type="total_profit" id="btpm_total_profit_sl"></block>
                </value>
                <value name="B">
                  <block type="math_single" id="btpm_negative_stop_loss">
                    <field name="OP">NEG</field>
                    <value name="NUM">
                      <block type="variables_get" id="btpm_read_stop_loss">
                        <field name="VAR" id="btpm_stop_loss">Stop Loss</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO1">
              <block type="text_print" id="btpm_stop_loss_message">
                <value name="TEXT">
                  <shadow type="text" id="btpm_stop_loss_text">
                    <field name="TEXT">Stop Loss reached</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="trade_again" id="btpm_continue_trading"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="btpm_purchase" collapsed="true" deletable="false" x="0" y="1150">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="btpm_direction_choice">
        <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="2"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="btpm_direction_is_even">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="btpm_direction_read_even">
                <field name="VAR" id="btpm_direction">Trade Direction</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="btpm_even_direction_number">
                <field name="NUM">0</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="apollo_purchase2" id="btpm_buy_even">
            <field name="PURCHASE_LIST">DIGITODD</field>
            <value name="PREDICTION">
              <shadow type="math_number_positive" id="btpm_prediction_even">
                <field name="NUM">5</field>
              </shadow>
            </value>
          </block>
        </statement>
        <value name="IF1">
          <block type="logic_compare" id="btpm_direction_is_odd">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="btpm_direction_read_odd">
                <field name="VAR" id="btpm_direction">Trade Direction</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="btpm_odd_direction_number">
                <field name="NUM">1</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO1">
          <block type="apollo_purchase2" id="btpm_buy_odd">
            <field name="PURCHASE_LIST">DIGITEVEN</field>
            <value name="PREDICTION">
              <shadow type="math_number_positive" id="btpm_prediction_odd">
                <field name="NUM">5</field>
              </shadow>
            </value>
          </block>
        </statement>
        <value name="IF2">
          <block type="logic_compare" id="btpm_direction_is_repeat">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="btpm_direction_read_repeat">
                <field name="VAR" id="btpm_direction">Trade Direction</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="btpm_repeat_direction_number">
                <field name="NUM">4</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO2">
          <block type="apollo_purchase2" id="btpm_buy_repeat">
            <field name="PURCHASE_LIST">DIGITOVER</field>
            <value name="PREDICTION">
              <shadow type="math_number_positive" id="btpm_prediction_repeat">
                <field name="NUM">2</field>
              </shadow>
            </value>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
