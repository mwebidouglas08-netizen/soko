<xml xmlns="https://developers.google.com/blockly/xml" collection="false" is_dbot="true">
  <variables>
    <variable id="tmf_stake">Stake</variable>
    <variable id="tmf_signal">Entry Signal</variable>
    <variable id="tmf_take_profit">Take Profit</variable>
    <variable id="Kc3A+R7Kq]/a=$ACDW!y">Stake []</variable>
    <variable id="tmf_direction">Trade Direction</variable>
    <variable id="tmf_stop_loss">Stop Loss</variable>
  </variables>
  <block type="trade_definition" id="tmf_trade_definition" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="tmf_market" deletable="false" movable="false">
        <mutation xmlns="http://www.w3.org/1999/xhtml" vh_enabled="false" vh_max_steps="1" vh_min_trades="1" vh_stake="0.35"></mutation>
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_25</field>
        <field name="ALTERNATE_MARKETS">FALSE</field>
        <field name="ALTERNATE_EVERY">1</field>
        <field name="MULTI_MARKET">FALSE</field>
        <field name="VH_ENABLED">FALSE</field>
        <field name="VH_SETTINGS_BTN">VH Settings</field>
        <next>
          <block type="trade_definition_tradetype" id="tmf_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="tmf_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">call</field>
                <next>
                  <block type="trade_definition_candleinterval" id="tmf_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="tmf_restart_buy_sell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="tmf_restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="tmf_set_stake">
        <field name="VAR" id="tmf_stake">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="tmf_stake_value">
            <field name="NUM">0.5</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="tmf_set_take_profit">
            <field name="VAR" id="tmf_take_profit">Take Profit</field>
            <value name="VALUE">
              <block type="math_number" id="tmf_take_profit_value">
                <field name="NUM">12</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="tmf_set_stop_loss">
                <field name="VAR" id="tmf_stop_loss">Stop Loss</field>
                <value name="VALUE">
                  <block type="math_number" id="tmf_stop_loss_value">
                    <field name="NUM">45</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="tmf_reset_runs_start" collapsed="true">
                    <field name="VAR" id="tmf_direction">Trade Direction</field>
                    <value name="VALUE">
                      <block type="math_number" id="tmf_direction_start">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="variables_set" id="tmf_set_base_stake" collapsed="true">
        <field name="VAR" id="Kc3A+R7Kq]/a=$ACDW!y">Stake []</field>
        <value name="VALUE">
          <block type="variables_get" id="tmf_base_stake_read">
            <field name="VAR" id="tmf_stake">Stake</field>
          </block>
        </value>
        <next>
          <block type="trade_definition_tradeoptions" id="tmf_trade_options">
            <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
            <field name="DURATIONTYPE_LIST">t</field>
            <value name="DURATION">
              <shadow type="math_number_positive" id="tmf_duration">
                <field name="NUM">5</field>
              </shadow>
            </value>
            <value name="AMOUNT">
              <shadow type="math_number_positive" id="tmf_amount_shadow">
                <field name="NUM">1</field>
              </shadow>
              <block type="variables_get" id="tmf_get_stake">
                <field name="VAR" id="tmf_stake">Stake</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="tmf_after_purchase" x="714" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="tmf_result_check" collapsed="true">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="tmf_is_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="tmf_reset_stake_on_win">
            <field name="VAR" id="tmf_stake">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="tmf_base_stake_on_win">
                <field name="VAR" id="Kc3A+R7Kq]/a=$ACDW!y">Stake []</field>
              </block>
            </value>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="tmf_tp_sl_gate" collapsed="true">
            <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1" else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="tmf_take_profit_check">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="total_profit" id="tmf_total_profit_tp"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="tmf_read_take_profit">
                    <field name="VAR" id="tmf_take_profit">Take Profit</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="text_print" id="tmf_take_profit_message">
                <value name="TEXT">
                  <shadow type="text" id="tmf_take_profit_text">
                    <field name="TEXT">Take Profit reached</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <value name="IF1">
              <block type="logic_compare" id="tmf_stop_loss_check">
                <field name="OP">LTE</field>
                <value name="A">
                  <block type="total_profit" id="tmf_total_profit_sl"></block>
                </value>
                <value name="B">
                  <block type="math_single" id="tmf_negative_stop_loss">
                    <field name="OP">NEG</field>
                    <value name="NUM">
                      <block type="variables_get" id="tmf_read_stop_loss">
                        <field name="VAR" id="tmf_stop_loss">Stop Loss</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO1">
              <block type="text_print" id="tmf_stop_loss_message">
                <value name="TEXT">
                  <shadow type="text" id="tmf_stop_loss_text">
                    <field name="TEXT">Stop Loss reached</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="trade_again" id="tmf_continue_trading"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="tmf_purchase" collapsed="true" deletable="false" x="0" y="1150">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="apollo_purchase2" id="tmf_buy_call">
        <field name="PURCHASE_LIST">CALL</field>
      </block>
    </statement>
  </block>
</xml>
