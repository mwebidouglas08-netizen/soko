<xml xmlns="https://developers.google.com/blockly/xml" collection="false" is_dbot="true">
  <variables>
    <variable id="mz_stake">Stake</variable>
    <variable id="mz_base_stake">Base Stake</variable>
    <variable id="mz_martingale">Martingale</variable>
    <variable id="mz_take_profit">Take Profit</variable>
    <variable id="mz_stop_loss">Stop Loss</variable>
    <variable id="mz_max_trades">Max Trades</variable>
    <variable id="mz_trades">Trades</variable>
    <variable id="mz_signal">Entry Signal</variable>
    <variable id="mz_direction">Trade Direction</variable>
    <variable id="mz_prediction">Prediction</variable>
    <variable id="mz_loss_streak">Loss Streak</variable>
    <variable id="mz_max_loss_streak">Max Loss Streak</variable>
    <variable id="mz_duration">Duration</variable>
    <variable id="mz_recover_amount">Recover Amount</variable>
    <variable id="mz_max_stake">Max Stake</variable>
    <variable id="mz_scan">Scan</variable>
    <variable id="mz_confidence">Confidence</variable>
  </variables>
  <block type="trade_definition" id="mz_trade_definition" deletable="false" x="0" y="60">
    <comment pinned="false" h="300" w="640">Maziwa AI v4: aggressively scans all open Deriv synthetic volatility markets in parallel and enters immediately only on favorable, high-confidence Over/Under setups (Over 2 / Under 8, 1 tick) using live digit bias, safe-streak, and edge scoring. Uses strict risk controls (tight TP/SL, low exposure, capped/conservative recovery, loss-streak halt/reset) to protect capital. Trading is risky; outcomes are not guaranteed and losses are possible. Test on demo before using real funds.</comment>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="mz_market" deletable="false" movable="false">
        <mutation xmlns="http://www.w3.org/1999/xhtml" vh_enabled="false" vh_max_steps="1" vh_min_trades="1" vh_stake="0.35"></mutation>
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_10</field>
        <field name="VH_ENABLED">FALSE</field>
        <field name="VH_SETTINGS_BTN">VH Settings</field>
        <next><block type="trade_definition_tradetype" id="mz_trade_type" deletable="false" movable="false">
          <field name="TRADETYPECAT_LIST">digits</field>
          <field name="TRADETYPE_LIST">overunder</field>
          <next><block type="trade_definition_contracttype" id="mz_contract_type" deletable="false" movable="false">
            <field name="TYPE_LIST">both</field>
            <next><block type="trade_definition_candleinterval" id="mz_interval" deletable="false" movable="false">
              <field name="CANDLEINTERVAL_LIST">60</field>
              <next><block type="trade_definition_restartbuysell" id="mz_restart_buy_sell" deletable="false" movable="false">
                <field name="TIME_MACHINE_ENABLED">FALSE</field>
                <next><block type="trade_definition_restartonerror" id="mz_restart_error" deletable="false" movable="false">
                  <field name="RESTARTONERROR">TRUE</field>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="mz_set_stake"><field name="VAR" id="mz_stake">Stake</field><value name="VALUE"><block type="math_number"><field name="NUM">0.35</field></block></value>
      <next><block type="variables_set" id="mz_set_base"><field name="VAR" id="mz_base_stake">Base Stake</field><value name="VALUE"><block type="math_number"><field name="NUM">0.35</field></block></value>
      <next><block type="variables_set" id="mz_set_mg"><field name="VAR" id="mz_martingale">Martingale</field><value name="VALUE"><block type="math_number"><field name="NUM">1.45</field></block></value>
      <next><block type="variables_set" id="mz_set_tp"><field name="VAR" id="mz_take_profit">Take Profit</field><value name="VALUE"><block type="math_number"><field name="NUM">3</field></block></value>
      <next><block type="variables_set" id="mz_set_sl"><field name="VAR" id="mz_stop_loss">Stop Loss</field><value name="VALUE"><block type="math_number"><field name="NUM">8</field></block></value>
      <next><block type="variables_set" id="mz_set_mt"><field name="VAR" id="mz_max_trades">Max Trades</field><value name="VALUE"><block type="math_number"><field name="NUM">500</field></block></value>
      <next><block type="variables_set" id="mz_set_tr"><field name="VAR" id="mz_trades">Trades</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
      <next><block type="variables_set" id="mz_set_sig"><field name="VAR" id="mz_signal">Entry Signal</field><value name="VALUE"><block type="logic_boolean"><field name="BOOL">FALSE</field></block></value>
      <next><block type="variables_set" id="mz_set_dir"><field name="VAR" id="mz_direction">Trade Direction</field><value name="VALUE"><block type="math_number"><field name="NUM">4</field></block></value>
      <next><block type="variables_set" id="mz_set_pred"><field name="VAR" id="mz_prediction">Prediction</field><value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value>
      <next><block type="variables_set" id="mz_set_ls"><field name="VAR" id="mz_loss_streak">Loss Streak</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
      <next><block type="variables_set" id="mz_set_mls"><field name="VAR" id="mz_max_loss_streak">Max Loss Streak</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
      <next><block type="variables_set" id="mz_set_dur"><field name="VAR" id="mz_duration">Duration</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
      <next><block type="variables_set" id="mz_set_rec"><field name="VAR" id="mz_recover_amount">Recover Amount</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
      <next><block type="variables_set" id="mz_set_ms"><field name="VAR" id="mz_max_stake">Max Stake</field><value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value>
      <next><block type="variables_set" id="mz_set_scan"><field name="VAR" id="mz_scan">Scan</field><value name="VALUE"><block type="lists_create_with"><mutation items="0"></mutation></block></value>
      <next><block type="variables_set" id="mz_set_conf"><field name="VAR" id="mz_confidence">Confidence</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
      </block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block>
    </statement>
    <statement name="SUBMARKET">
      <block type="variables_set" id="mz_reset_sig"><field name="VAR" id="mz_signal">Entry Signal</field><value name="VALUE"><block type="logic_boolean"><field name="BOOL">FALSE</field></block></value>
      <next><block type="controls_whileUntil" id="mz_scan_loop" collapsed="true"><field name="MODE">UNTIL</field><value name="BOOL"><block type="variables_get"><field name="VAR" id="mz_signal">Entry Signal</field></block></value>
        <statement name="DO"><block type="timeout" id="mz_delay"><statement name="TIMEOUTSTACK">
          <block type="variables_set" id="mz_do_scan"><field name="VAR" id="mz_scan">Scan</field>
            <value name="VALUE"><block type="maziwa_scan_signal">
              <value name="MIN_CONFIDENCE"><shadow type="math_number"><field name="NUM">72</field></shadow></value>
              <value name="WINDOW"><shadow type="math_number"><field name="NUM">25</field></shadow></value>
              <value name="MAX_SYMBOLS"><shadow type="math_number"><field name="NUM">40</field></shadow></value>
            </block></value>
          <next><block type="controls_if" id="mz_use_scan"><value name="IF0"><block type="logic_compare"><field name="OP">GT</field>
            <value name="A"><block type="lists_length"><value name="VALUE"><block type="variables_get"><field name="VAR" id="mz_scan">Scan</field></block></value></block></value>
            <value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
            <statement name="DO0">
              <block type="variables_set" id="mz_conf_set"><field name="VAR" id="mz_confidence">Confidence</field><value name="VALUE"><block type="lists_getIndex"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="mz_scan">Scan</field></block></value><value name="AT"><block type="math_number"><field name="NUM">4</field></block></value></block></value>
              <next><block type="maziwa_set_symbol" id="mz_apply_sym"><value name="SYMBOL"><block type="lists_getIndex"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="mz_scan">Scan</field></block></value><value name="AT"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
              <next><block type="variables_set" id="mz_set_dir_scan"><field name="VAR" id="mz_direction">Trade Direction</field><value name="VALUE"><block type="lists_getIndex"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="mz_scan">Scan</field></block></value><value name="AT"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
              <next><block type="variables_set" id="mz_set_pred_scan"><field name="VAR" id="mz_prediction">Prediction</field><value name="VALUE"><block type="lists_getIndex"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="mz_scan">Scan</field></block></value><value name="AT"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
              <next><block type="variables_set" id="mz_set_signal_true"><field name="VAR" id="mz_signal">Entry Signal</field><value name="VALUE"><block type="logic_boolean"><field name="BOOL">TRUE</field></block></value></block></next></block></next></block></next></block></next></block>
            </statement>
          </block></next></block>
        </statement><value name="SECONDS"><block type="math_number"><field name="NUM">0.03</field></block></value></block></statement>
        <next><block type="trade_definition_tradeoptions" id="mz_opts"><mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation><field name="DURATIONTYPE_LIST">t</field><value name="DURATION"><block type="variables_get"><field name="VAR" id="mz_duration">Duration</field></block></value><value name="AMOUNT"><shadow type="math_number_positive"><field name="NUM">0.35</field></shadow><block type="variables_get"><field name="VAR" id="mz_stake">Stake</field></block></value><value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">2</field></shadow><block type="variables_get"><field name="VAR" id="mz_prediction">Prediction</field></block></value></block></next>
      </block></next></block>
    </statement>
  </block>
  <block type="after_purchase" id="mz_after" x="760" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="math_change"><field name="VAR" id="mz_trades">Trades</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
      <next><block type="variables_set"><field name="VAR" id="mz_signal">Entry Signal</field><value name="VALUE"><block type="logic_boolean"><field name="BOOL">FALSE</field></block></value>
      <next><block type="controls_if"><mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0"><block type="contract_check_result"><field name="CHECK_RESULT">win</field></block></value>
        <statement name="DO0">
          <block type="controls_if"><mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_recover_amount">Recover Amount</field></block></value><value name="B"><block type="read_details"><field name="DETAIL_INDEX">4</field></block></value></block></value>
            <statement name="DO0"><block type="variables_set"><field name="VAR" id="mz_recover_amount">Recover Amount</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_recover_amount">Recover Amount</field></block></value><value name="B"><block type="read_details"><field name="DETAIL_INDEX">4</field></block></value></block></value></block></statement>
            <statement name="ELSE"><block type="variables_set"><field name="VAR" id="mz_recover_amount">Recover Amount</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement>
            <next><block type="variables_set"><field name="VAR" id="mz_loss_streak">Loss Streak</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
            <next><block type="controls_if"><mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
              <value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_recover_amount">Recover Amount</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
              <statement name="DO0"><block type="variables_set"><field name="VAR" id="mz_stake">Stake</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MIN</field>
                <value name="A"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_base_stake">Base Stake</field></block></value><value name="B"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_recover_amount">Recover Amount</field></block></value><value name="B"><block type="math_number"><field name="NUM">1.05</field></block></value></block></value></block></value>
                <value name="B"><block type="variables_get"><field name="VAR" id="mz_max_stake">Max Stake</field></block></value></block></value></block></statement>
              <statement name="ELSE"><block type="variables_set"><field name="VAR" id="mz_stake">Stake</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="mz_base_stake">Base Stake</field></block></value></block></statement>
            </block></next></block></next></block>
        </statement>
        <statement name="ELSE">
          <block type="math_change"><field name="VAR" id="mz_loss_streak">Loss Streak</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
          <next><block type="variables_set"><field name="VAR" id="mz_recover_amount">Recover Amount</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_recover_amount">Recover Amount</field></block></value><value name="B"><block type="math_single"><field name="OP">ABS</field><value name="NUM"><block type="read_details"><field name="DETAIL_INDEX">4</field></block></value></block></value></block></value>
          <next><block type="controls_if"><mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_loss_streak">Loss Streak</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="mz_max_loss_streak">Max Loss Streak</field></block></value></block></value>
            <statement name="DO0"><block type="variables_set"><field name="VAR" id="mz_stake">Stake</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MIN</field>
              <value name="A"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_stake">Stake</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="mz_martingale">Martingale</field></block></value></block></value>
              <value name="B"><block type="variables_get"><field name="VAR" id="mz_max_stake">Max Stake</field></block></value></block></value></block></statement>
            <statement name="ELSE"><block type="variables_set"><field name="VAR" id="mz_stake">Stake</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MIN</field><value name="A"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_base_stake">Base Stake</field></block></value><value name="B"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_recover_amount">Recover Amount</field></block></value><value name="B"><block type="math_number"><field name="NUM">1.0</field></block></value></block></value></block></value><value name="B"><block type="variables_get"><field name="VAR" id="mz_max_stake">Max Stake</field></block></value></block></value>
            <next><block type="variables_set"><field name="VAR" id="mz_loss_streak">Loss Streak</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_set"><field name="VAR" id="mz_recover_amount">Recover Amount</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_recover_amount">Recover Amount</field></block></value><value name="B"><block type="math_number"><field name="NUM">0.5</field></block></value></block></value></block></next></block></next></block></statement>
          </block></next></block></next></block>
        </statement>
        <next><block type="controls_if"><mutation xmlns="http://www.w3.org/1999/xhtml" elseif="2" else="1"></mutation>
          <value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="total_profit"></block></value><value name="B"><block type="variables_get"><field name="VAR" id="mz_take_profit">Take Profit</field></block></value></block></value>
          <statement name="DO0"><block type="text_print"><value name="TEXT"><shadow type="text"><field name="TEXT">Maziwa AI: Take Profit reached. Session stopped.</field></shadow></value></block></statement>
          <value name="IF1"><block type="logic_compare"><field name="OP">LTE</field><value name="A"><block type="total_profit"></block></value><value name="B"><block type="math_single"><field name="OP">NEG</field><value name="NUM"><block type="variables_get"><field name="VAR" id="mz_stop_loss">Stop Loss</field></block></value></block></value></block></value>
          <statement name="DO1"><block type="text_print"><value name="TEXT"><shadow type="text"><field name="TEXT">Maziwa AI: Stop Loss reached. Session stopped.</field></shadow></value></block></statement>
          <value name="IF2"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_trades">Trades</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="mz_max_trades">Max Trades</field></block></value></block></value>
          <statement name="DO2"><block type="text_print"><value name="TEXT"><shadow type="text"><field name="TEXT">Maziwa AI: Max trades reached. Session stopped.</field></shadow></value></block></statement>
          <statement name="ELSE"><block type="trade_again"></block></statement>
        </block></next></block></next></block></next></block>
    </statement>
  </block>
  <block type="before_purchase" id="mz_before" collapsed="true" deletable="false" x="0" y="1200">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if"><mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1" else="1"></mutation>
        <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_direction">Trade Direction</field></block></value><value name="B"><block type="math_number"><field name="NUM">4</field></block></value></block></value>
        <statement name="DO0"><block type="apollo_purchase2"><field name="PURCHASE_LIST">DIGITOVER</field><value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">2</field></shadow><block type="variables_get"><field name="VAR" id="mz_prediction">Prediction</field></block></value></block></statement>
        <value name="IF1"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="mz_direction">Trade Direction</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
        <statement name="DO1"><block type="apollo_purchase2"><field name="PURCHASE_LIST">DIGITUNDER</field><value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">8</field></shadow><block type="variables_get"><field name="VAR" id="mz_prediction">Prediction</field></block></value></block></statement>
        <statement name="ELSE"><block type="apollo_purchase2"><field name="PURCHASE_LIST">DIGITOVER</field><value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">2</field></shadow></value></block></statement>
      </block>
    </statement>
  </block>
</xml>
